# VANA Furniture Server — environment configuration
# Copy this file to `.env` (same directory) and fill in real values.
# NEVER commit the real `.env` file.

# Node environment: "development" | "production" | "test"
# In production, JWT_SECRET and ADMIN_PASSWORD_HASH become REQUIRED — the
# server will refuse to boot without them (see config.js).
NODE_ENV=development

# Port the HTTP/WebSocket server listens on.
PORT=5000

# Secret used to sign & verify admin JWTs. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars

# Admin login email checked against on POST /api/auth/login (falls back to
# this single-admin config if server/data/users.json is missing).
ADMIN_EMAIL=admin@example.com

# Bcrypt hash of the admin password (never store the plaintext password).
# Generate one with:
#   node -e "console.log(require('bcryptjs').hashSync('yourStrongPassword', 10))"
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash-like-$2a$10$examplehashexamplehashexamplehashexamplehas

# Comma-separated list of origins allowed by CORS in production, e.g.:
#   ALLOWED_ORIGINS=https://your-storefront.com,https://admin.your-storefront.com
# If unset, a localhost/127.0.0.1 dev whitelist is used.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Outbound email (server/utils/email.js). Optional — when SMTP_HOST/USER/PASS
# are unset, email sending no-ops with a console.log instead of erroring, so
# dev/test never breaks. Needed for real newsletter unsubscribe/notification
# mail once you have an SMTP provider (e.g. SendGrid, Mailgun, SES SMTP, a
# Gmail app password, etc.).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=VANA Furniture <no-reply@vana-furniture.com>

# Public base URL used to build links in outbound email (e.g. the newsletter
# unsubscribe link). Falls back to http://localhost:PORT in dev.
PUBLIC_API_URL=http://localhost:5000
