# Dependencies
node_modules/
**/node_modules/
.opencode/node_modules/

# Build output
client/dist/
dist/

# Environment variables (never commit secrets)
.env
.env.*
!.env.example
!server/.env.example

# Runtime / generated data (seeded via `npm run seed`, not source)
server/data/*.json

# Uploaded files (user/admin generated at runtime)
server/uploads/*
!server/uploads/.gitkeep
!server/uploads/cad/.gitkeep
!server/uploads/products/.gitkeep

# Backup snapshots (generated by scripts/backup.js, keep dir out of VCS)
backups/

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor directories
.vscode/
.idea/
